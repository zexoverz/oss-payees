{
  "name": "oss-payees",
  "version": "0.1.0",
  "description": "Find where an open-source package wants to be paid (Drips FUNDING.json, tea.yaml, npm funding, GitHub FUNDING.yml), normalized and checked for conflicts, lookalikes and spoofed repos before anyone pays it.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zexoverz/oss-payees.git"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@endcredits-demo/left-padder-pro": "github:zexoverz/endcredits-fixture-left-padder-pro",
    "@endcredits-demo/moved-payout": "github:zexoverz/endcredits-fixture-moved-payout",
    "@endcredits-demo/swapped-jar": "github:zexoverz/endcredits-fixture-swapped-jar",
    "@endcredits-demo/tip-jar": "github:zexoverz/endcredits-fixture-tip-jar",
    "@endcredits-demo/unclaimed-utils": "github:zexoverz/endcredits-fixture-unclaimed-utils",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "funding",
    "open-source",
    "drips",
    "tea",
    "payout",
    "web3",
    "viem",
    "security"
  ],
  "bin": {
    "oss-payees": "dist/cli.js"
  },
  "homepage": "https://github.com/zexoverz/oss-payees"
}
