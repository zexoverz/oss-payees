{
  "name": "daterange-kit",
  "version": "0.1.0",
  "description": "Parse and validate human date ranges (\"last 7 days\", \"2026-09-01..2026-09-26\", \"this month\") into typed { from, to } objects.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zexoverz/daterange-kit.git"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
